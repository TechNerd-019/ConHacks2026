{
  "expo": {
    "name": "PlantHub",
    "slug": "planthub",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fafafa"
    },
    "android": {
      "permissions": ["CAMERA"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fafafa"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PlantHub to use your camera to photograph plants."
        }
      ]
    ]
  }
}
